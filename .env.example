# Copy this file to .env and fill in your values:  cp .env.example .env
# .env is gitignored — never commit your real key.

# REQUIRED — your real OpenAI API key. The gateway holds this server-side and
# never exposes it to clients; they authenticate with the seeded gateway keys
# (sk-demo-alice / sk-demo-bob) instead.
OPENAI_API_KEY=sk-your-openai-key-here

# OPTIONAL — upstream provider base URL. Defaults to https://api.openai.com.
# Override to point at a mock or a compatible provider.
UPSTREAM_URL=https://api.openai.com

# OPTIONAL — port the gateway listens on. Defaults to 8080.
PORT=8080
